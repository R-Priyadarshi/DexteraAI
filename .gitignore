# ── Byte-compiled / cached ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──
.venv/
venv/
env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Env files ──
.env
.env.local
.env.*.local

# ── ML artifacts ──
*.onnx
*.tflite
*.pt
*.pth
*.pkl
*.pickle
checkpoints/
models/*.onnx
models/*.tflite
models/**/*.onnx
models/**/*.onnx.data
*.onnx.data
# fetched via `make fetch-models`
models/mediapipe/
!models/.gitkeep
# small, describes the bundle's vocabulary
!models/**/labels.json
# The two shipped bundles are the product, not a build artifact: ~2.3MB each,
# retrained rarely, and without them a fresh clone has no model to run. Every
# other export stays ignored — un-ignore a bundle here only when it ships.
!models/hagrid/gesture.onnx
!models/hagrid/gesture.onnx.data
!models/asl_alphabet/gesture.onnx
!models/asl_alphabet/gesture.onnx.data

# ── MLflow ──
mlruns/
mlartifacts/
mlflow.db

# ── DVC ──
/data
*.dvc.lock

# ── Logs ──
logs/
*.log

# ── Coverage ──
.coverage
htmlcov/
.pytest_cache/
.hypothesis/
.benchmarks/

# ── SQLite DBs ──
*.db

# ── Node (web app) ──
node_modules/
.next/
out/
apps/web/.next/
apps/web/node_modules/

# ── Flutter ──
apps/mobile/.dart_tool/
apps/mobile/build/

# ── Tauri ──
apps/desktop/src-tauri/target/

# ── Web runtime assets (restored by `npm run sync-runtime`) ──
# Large WASM binaries that ship inside npm packages. Keeping them in git would
# add ~170MB of history for files that `npm install` already provides.
apps/web/public/onnx/*.wasm
apps/web/public/onnx/*.mjs
apps/web/public/onnx/mediapipe/
# MediaPipe Tasks WASM for the face landmarker, copied from node_modules by
# scripts/sync-runtime.sh. Large binaries that npm already ships.
apps/web/public/onnx/tasks/
# Model bundles here are copies of models/<name>/, placed by sync-runtime.sh.
# The originals are tracked; copying them into git too would double the weight
# for no gain.
apps/web/public/onnx/**/*.onnx
apps/web/public/onnx/**/*.onnx.data
!apps/web/public/onnx/**/labels.json

# TypeScript incremental build cache
*.tsbuildinfo
